{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",

  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },

  "files": {
    "ignoreUnknown": false,
    "includes": ["**", "!!src/styles/**/*.css", "!!public/**/*.svg"]
  },

  "formatter": {
    "enabled": false
  },

  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },

  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },

  "tailwind": {
    "stylesheet": "./src/styles/globals.css",
    "mergeFunctions": ["clsx", "cn", "twMerge"],
    "variantFunctions": ["cva"],
    "attributes": ["class", "className"]
  },

  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
