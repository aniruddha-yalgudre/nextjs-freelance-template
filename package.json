{
  "name": "my-nextjs-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint . && eslint .",
    "lint:fix": "biome lint --write . && eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "validate": "pnpm check && pnpm build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "biome lint --write",
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,jsonc,css,md,mdx}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "lucide-react": "1.77.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "next-sitemap": "^4.2.3",
    "next-themes": "^0.4.6",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "husky": "9.1.7",
    "lint-staged": "17.6.1",
    "postcss": "8.5.33",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
